# `terraform.tfvars`로 복사해서 사용한다.
# 시크릿(텔레그램 토큰·Cloudflare 자격증명)은 여기에 넣지 않는다 —
# 서버 .env에 SSH로 직접 작성한다. tfstate에 평문으로 남기지 않기 위해서다.

# --- 위치와 사양 ---------------------------------------------------------
aws_region        = "ap-northeast-2"
availability_zone = "ap-northeast-2a"
bundle_id         = "micro_3_0" # $7/월, 1GB. nano_3_0(512MB)은 pandas를 못 버틴다
blueprint_id      = "ubuntu_24_04"

# --- 이름 ----------------------------------------------------------------
instance_name = "china-chatbot"
service_name  = "china-chatbot"

# --- 소스 ----------------------------------------------------------------
repo_url = "https://github.com/tkddls8848/china_chatbot.git"
repo_ref = "main"

# --- 접근 제어 -----------------------------------------------------------
# Windows 경로는 역슬래시가 아니라 슬래시로 쓴다.
ssh_public_key_path = "C:/Users/<사용자>/.ssh/id_ed25519.pub"

# 방화벽을 Lightsail 콘솔에서 직접 관리하려면 false.
# false로 두면 인스턴스가 기본 규칙(22/80/443 개방)으로 뜨므로,
# 생성 직후 콘솔에서 80/443을 닫아야 한다.
manage_firewall = true

# manage_firewall = true 일 때만 적용. 고정 회선이면 자기 IP로 좁힌다.
# 확인: curl -s https://checkip.amazonaws.com
allowed_ssh_cidrs = ["0.0.0.0/0"]

# --- 부트스트랩 ----------------------------------------------------------
swap_size             = "2G"
timezone              = "Asia/Seoul"
backup_retention_days = 14

# --- 스냅샷 --------------------------------------------------------------
enable_auto_snapshot = true
auto_snapshot_time   = "19:00" # UTC 정시만 허용. 19:00 UTC = 04:00 KST
