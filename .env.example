# ── 설정 저장 방침 ──────────────────────────────────────────
# .env        = 모든 설정의 유일한 원본. 봇 시작 시 1회 app/core/config.py에서만 읽는다.
# data/*.json = 봇이 수집·축적하는 데이터(관심종목, 전송 이력, 종목 DB 등).
#               설정값은 저장하지 않는다. 텔레그램 명령으로 바꾼 런타임 설정은
#               세션 한정이며 재시작하면 .env 값으로 되돌아간다.
# ────────────────────────────────────────────────────────────

# Telegram
TELEGRAM_BOT_TOKEN=<텔레그램 봇 토큰>
TELEGRAM_CHAT_ID=<전송할 채널 또는 채팅방 ID>
# 명령을 허용할 chat_id 목록(쉼표 구분). 비우면 모두 허용(기존 동작).
# 예: ALLOWED_CHAT_IDS=123456789,-1001234567890
ALLOWED_CHAT_IDS=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# num_gpu 설정: -1=GPU 자동, 0=CPU 전용, N=오프로딩 레이어 수
# 텔레그램 /system gpu on|off|<레이어수> 로 세션 한정 변경 가능하며,
# 재시작하면 이 값으로 되돌아간다.
OLLAMA_NUM_GPU=0
# /system gpu on 으로 켤 때 사용할 값(-1=자동 권장)
OLLAMA_GPU_ON_VALUE=-1

# Translation
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=gemma4:e4b
TRANSLATION_TIMEOUT=60
TRANSLATION_NUM_PREDICT=4096
TRANSLATION_PROMPT_DIR=prompts
TRANSLATION_CONCURRENCY=1

# Scheduled news fetch
NEWS_GLOBAL_LIMIT=3
NEWS_STOCK_LIMIT_PER_SYMBOL=3
# 전역 뉴스 소스 우선순위 목록(쉼표 구분). 사용 가능: futu, em, sina, ths, cls
# 비우면 기본 futu,em,sina (+ NEWS_ENABLE_CLS=true면 cls 추가).
NEWS_GLOBAL_SOURCES=
# RSS 피드 추가: '라벨|URL,라벨|URL' 형식. RSSHub 셀프호스팅 라우트 사용 가능.
# 예: NEWS_RSS_FEEDS=재련사RSS|http://localhost:1200/cls/telegraph
NEWS_RSS_FEEDS=
# 소스가 연속 N회 실패하면 M분 쿨다운 후 자동 재시도(수동 토글 불필요).
NEWS_SOURCE_FAILURE_THRESHOLD=3
NEWS_SOURCE_COOLDOWN_MINUTES=60
# CLS(재련사) AkShare 엔드포인트가 404를 반환하는 동안은 false 권장.
# NEWS_GLOBAL_SOURCES를 직접 지정하면 이 값은 무시된다.
NEWS_ENABLE_CLS=false
# 뉴스 메시지에 LLM 감성 점수(-1~1) 표기 여부.
NEWS_SENTIMENT_ENABLED=true
# 관심종목 관련 뉴스의 감성이 이 값 이하이면 ⚠️ 경고 머리말을 붙인다.
NEWS_NEGATIVE_ALERT_THRESHOLD=-0.6
# /view 감성 뷰 집계에 사용할 최근 신호 일수.
VIEW_LOOKBACK_DAYS=3
# 외부 뉴스 API 호출 1건의 최대 대기 시간(초).
NEWS_SOURCE_FETCH_TIMEOUT_SECONDS=45
# 한 주기에 처리할 관심종목 수(회전 처리). 0 이하면 매 주기 전체 처리.
# 전체 종목을 매 주기 일괄 요청/번역하지 않고 여러 주기에 나눠 부하를 분산한다.
STOCK_NEWS_BATCH_SIZE=3
# 배치 내 종목 간 외부 API 호출 사이 지연(초). 0이면 지연 없음.
STOCK_NEWS_FETCH_DELAY_SECONDS=0
# 한 주기에 처리할 전역 속보 소스(CLS/Futu) 수. 1이면 매 주기 한 소스씩 번갈아 처리.
# 0 이하이면 매 주기 전체(CLS+Futu) 처리.
GLOBAL_NEWS_BATCH_SIZE=1

# Scheduler and state
SCHEDULER_INTERVAL_MINUTES=4
SENT_NEWS_MAX_IDS=0
SENT_NEWS_RETENTION_DAYS=7

# Stock database
STOCK_DB_ENABLED=true
