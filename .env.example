# Telegram
TELEGRAM_BOT_TOKEN=<텔레그램 봇 토큰>
TELEGRAM_CHAT_ID=<전송할 채널 또는 채팅방 ID>

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_GPU=0

# Translation
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=gemma4:e4b
TRANSLATION_TIMEOUT=60
TRANSLATION_NUM_PREDICT=4096
TRANSLATION_PROMPT_DIR=prompts
TRANSLATION_CONCURRENCY=1

# Scheduled news fetch
NEWS_GLOBAL_LIMIT=3
NEWS_STOCK_LIMIT_PER_SYMBOL=3

# Scheduler and state
SCHEDULER_INTERVAL_MINUTES=10
SENT_NEWS_MAX_IDS=0
SENT_NEWS_RETENTION_DAYS=7

# Stock database
STOCK_DB_ENABLED=true
EODHD_API_TOKEN=<EODHD API 토큰>
EODHD_ENRICH_LIMIT=200
EODHD_ENRICH_DELAY=0.5

# Research
RESEARCH_ANALYSIS_ENABLED=true
RESEARCH_ANALYSIS_MODEL=gemma4:e4b
RESEARCH_ANALYSIS_TIMEOUT=180
RESEARCH_ANALYSIS_NUM_PREDICT=2048
RESEARCH_NEWS_STOCK_LIMIT_PER_SYMBOL=3
RESEARCH_NEWS_MAX_ITEMS=3
RESEARCH_NEWS_GLOBAL_LIMIT=3

# Momentum
MOMENTUM_ENABLED=true
MOMENTUM_TOP_LIMIT=10
MOMENTUM_MIN_RESULT_SCORE=0
MOMENTUM_PRICE_LOOKBACK_DAYS=160
MOMENTUM_USE_POLICY_SCORE=true
MOMENTUM_REFRESH_COOLDOWN_MINUTES=10
MOMENTUM_PRICE_FETCH_DELAY_SECONDS=2.0
MOMENTUM_PRICE_MAX_CONSECUTIVE_FAILURES=3
MOMENTUM_DATA_DIR=data/momentum
MOMENTUM_DAILY_ALERT_ENABLED=false
MOMENTUM_DAILY_ALERT_HOUR=18
MOMENTUM_DAILY_ALERT_MINUTE=30
MOMENTUM_SECTOR_TOP_N_PER_SECTOR=20
MOMENTUM_MIN_SECTOR_MEMBER_COUNT=10
MOMENTUM_MIN_TRADING_DAYS_20D=15
MOMENTUM_MIN_AVG_TURNOVER_20D_CNY=30000000
MOMENTUM_CANDIDATE_MIN_AVG_TURNOVER_20D_CNY=50000000
MOMENTUM_DUPLICATE_ALERT_SUPPRESSION_DAYS=5
