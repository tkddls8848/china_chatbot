# ── 텔레그램 ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=           # 본인 텔레그램 ID (https://t.me/userinfobot 에서 확인)
WEBAPP_URL=                  # 로컬 개발 시 비워도 됨

# ── 데이터베이스 (SQLite) ──────────────────────────────
DATABASE_URL=sqlite:///./chinachat.db

# ── 앱 설정 ───────────────────────────────────────────
APP_ENV=development          # development=polling, production=webhook
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── 캐시 ──────────────────────────────────────────────
CACHE_TTL_SECONDS=900
