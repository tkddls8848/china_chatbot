# Copy to .env and fill the four required credentials.
TELEGRAM_BOT_TOKEN=<BotFather token>
TELEGRAM_CHAT_ID=<notification chat or channel ID>
ALLOWED_CHAT_IDS=
FEATURES_ENABLED=instruments,quant,watchlist,news,market_sentiment,research,briefing,signal_scoring,system_admin,web_admin

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_TRANSLATION_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# CLOUDFLARE_ANALYSIS_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_TRANSLATION_TIMEOUT=45
CLOUDFLARE_MAX_ATTEMPTS=2
CLOUDFLARE_FAILURE_THRESHOLD=3
CLOUDFLARE_FAILURE_COOLDOWN_SECONDS=300

# Optional local admin page
WEB_ADMIN_HOST=127.0.0.1
WEB_ADMIN_PORT=8787
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=

# Translation and news
TRANSLATION_ENABLED=true
TRANSLATION_NUM_PREDICT=1024
TRANSLATION_PROMPT_DIR=prompts
TRANSLATION_CONCURRENCY=1
NEWS_GLOBAL_LIMIT=3
NEWS_DIGEST_MESSAGE_MAX_CHARS=3500
NEWS_GLOBAL_SOURCES=futu,sina,gnews,gnews_us,gnews_kr
NEWS_RSS_FEEDS=mk-stock|https://www.mk.co.kr/rss/50200011/
NEWS_SOURCE_FAILURE_THRESHOLD=3
NEWS_SOURCE_COOLDOWN_MINUTES=60
NEWS_SENTIMENT_ENABLED=true
NEWS_NEGATIVE_ALERT_THRESHOLD=-0.6
NEWS_SOURCE_FETCH_TIMEOUT_SECONDS=45
NEWS_LIVE_MAX_AGE_HOURS=48
NEWS_SOURCE_ARTICLE_LIMIT=10
SCHEDULER_INTERVAL_MINUTES=5
SENT_NEWS_RETENTION_DAYS=7
NEWS_LOG_RETENTION_DAYS=30
VIEW_LOOKBACK_DAYS=3

# Instruments and research
STOCK_DB_ENABLED=true
RESEARCH_ANALYSIS_ENABLED=true
RESEARCH_ANALYSIS_TIMEOUT=600
RESEARCH_ANALYSIS_NUM_PREDICT=2048
RESEARCH_NEWS_MAX_ITEMS=6
RESEARCH_NEWS_GLOBAL_LIMIT=3
RESEARCH_NEWS_CONTENT_MAX_CHARS=240
RESEARCH_NEWS_MARKETS=CN,US,KR
RESEARCH_MAX_CANDIDATES=10
RESEARCH_NAME_TOKEN_MAX_FREQUENCY=15
RESEARCH_MAX_NEW_ACTIONS=4
RESEARCH_DISCOVERY_RESERVED_SLOTS=3
RESEARCH_REMOVE_RELEVANCE_THRESHOLD=0.35
RESEARCH_HISTORY_LIMIT=3
RESEARCH_SECTOR_CANDIDATES_ENABLED=true
RESEARCH_SECTOR_CANDIDATE_LIMIT=10
RESEARCH_US_CANDIDATES_ENABLED=true
RESEARCH_US_CANDIDATE_LIMIT=8
RESEARCH_US_SCREENERS=day_gainers,most_actives
RESEARCH_KR_CANDIDATES_ENABLED=true
RESEARCH_KR_CANDIDATE_LIMIT=8
RESEARCH_KR_MIN_TRADING_VALUE=5000000000
NON_URGENT_WORKER_COUNT=3
NON_URGENT_DEFER_TIMEOUT_SECONDS=180

# Quantitative context
QUANT_CONTEXT_ENABLED=true
QUANT_CACHE_TTL_MINUTES=10
QUANT_SECTOR_TOP_N=5
QUANT_FAILURE_COOLDOWN_MINUTES=15

# Market sentiment chart and daily digest
NEWS_SOURCE_MARKETS=rss:mk-stock:KR
NEWS_MARKET_BACKFILL_QUERIES=
MARKET_CHART_LOOKBACK_DAYS=7
MARKET_CHART_MIN_ARTICLES=6
MARKET_CHART_MIN_DAYS=3
MARKET_CHART_BACKFILL_DAYS_PER_REQUEST=7
MARKET_CHART_MARKETS=CN,HK,US,KR
MARKET_DIGEST_ENABLED=true
MARKET_DIGEST_ARTICLES_PER_DAY=20
MARKET_DIGEST_MIN_ARTICLES=5
MARKET_DIGEST_RETENTION_DAYS=30
MARKET_DIGEST_MAX_CALLS_PER_REQUEST=40
MARKET_DIGEST_NUM_PREDICT=256
MARKET_DIGEST_TIMEOUT=60
MARKET_DIGEST_COUNT_TOLERANCE_RATIO=0.1

# Scheduled briefings and scorecard (host local time)
BRIEFING_MORNING_ENABLED=true
BRIEFING_MORNING_HOUR=8
BRIEFING_MORNING_MINUTE=50
BRIEFING_EVENING_ENABLED=true
BRIEFING_EVENING_HOUR=17
BRIEFING_EVENING_MINUTE=40
BRIEFING_LLM_ENABLED=true
BRIEFING_TIMEOUT=120
BRIEFING_NEWS_MAX_ITEMS=5
WATCHLIST_SCORECARD_ENABLED=true
WATCHLIST_SCORECARD_DAY_OF_WEEK=sat
WATCHLIST_SCORECARD_HOUR=10
WATCHLIST_SCORECARD_LOOKBACK_DAYS=30
