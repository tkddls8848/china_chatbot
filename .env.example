# Copy to .env and fill these in. Everything here is either a secret/credential
# or a value that must never sit in git history — every other setting (feature
# flags, tuning knobs, schedules) lives as a literal constant in
# app/core/config.py instead. Changing those requires a code change, which is
# deliberate: git keeps the history of what changed and why.
TELEGRAM_BOT_TOKEN=<BotFather token>
TELEGRAM_CHAT_ID=<notification chat or channel ID>
# 명령을 받을 chat_id(쉼표 구분). 비면 기동하지 않는다 — 빈 값을 전체 허용으로
# 읽으면 봇 사용자명을 아는 누구나 상태를 고치고 Neurons를 태울 수 있다.
ALLOWED_CHAT_IDS=<notification chat or channel ID>

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 번역·분석 공용. Cloudflare가 폐기·개명하면 코드 배포 없이 바로 바꿔야
# 하므로(config.py 주석 참고) 예외적으로 env에 남긴다.
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# Optional local admin page(FEATURES_ENABLED의 web_admin 키로 켠다).
# 비밀번호를 지정해야만 기동한다.
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=

# Polymarket 거시 위험선호 컨센서스 — 지역 차단(451)에 막힐 때만 채운다
# (docs/server-ops.md 8-4). 비어 있으면(기본) 직접 호출한다.
POLYMARKET_PROXY_URL=
