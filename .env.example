# Telegram
TELEGRAM_BOT_TOKEN=<텔레그램 봇 토큰>
TELEGRAM_CHAT_ID=<전송할 채널 또는 채팅방 ID>

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# num_gpu 초기값: -1=GPU 자동, 0=CPU 전용, N=오프로딩 레이어 수
# 런타임에는 텔레그램 /system gpu on|off|<레이어수> 로 제어하며, 그 값은
# data/runtime_config.json 에 저장되어 재시작 후에도 유지된다(env 기본값보다 우선).
OLLAMA_NUM_GPU=0
# /system gpu on 으로 켤 때 사용할 값(-1=자동 권장)
OLLAMA_GPU_ON_VALUE=-1

# Translation
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=gemma4:e4b
TRANSLATION_TIMEOUT=60
TRANSLATION_NUM_PREDICT=4096
TRANSLATION_PROMPT_DIR=prompts
TRANSLATION_CONCURRENCY=1

# Scheduled news fetch
NEWS_GLOBAL_LIMIT=3
NEWS_STOCK_LIMIT_PER_SYMBOL=3
# CLS(재련사) AkShare 엔드포인트가 404를 반환하는 동안은 false 권장.
# AkShare/CLS API가 복구되면 true로 켤 수 있다.
NEWS_ENABLE_CLS=false
# 외부 뉴스 API 호출 1건의 최대 대기 시간(초).
NEWS_SOURCE_FETCH_TIMEOUT_SECONDS=45
# 한 주기에 처리할 관심종목 수(회전 처리). 0 이하면 매 주기 전체 처리.
# 전체 종목을 매 주기 일괄 요청/번역하지 않고 여러 주기에 나눠 부하를 분산한다.
STOCK_NEWS_BATCH_SIZE=3
# 배치 내 종목 간 외부 API 호출 사이 지연(초). 0이면 지연 없음.
STOCK_NEWS_FETCH_DELAY_SECONDS=0
# 한 주기에 처리할 전역 속보 소스(CLS/Futu) 수. 1이면 매 주기 한 소스씩 번갈아 처리.
# 0 이하이면 매 주기 전체(CLS+Futu) 처리.
GLOBAL_NEWS_BATCH_SIZE=1

# Scheduler and state
SCHEDULER_INTERVAL_MINUTES=4
SENT_NEWS_MAX_IDS=0
SENT_NEWS_RETENTION_DAYS=7

# Stock database
STOCK_DB_ENABLED=true
EODHD_API_TOKEN=<EODHD API 토큰>
EODHD_ENRICH_LIMIT=200
EODHD_ENRICH_DELAY=0.5

# Research
RESEARCH_ANALYSIS_ENABLED=true
RESEARCH_ANALYSIS_MODEL=gemma4:e4b
RESEARCH_ANALYSIS_TIMEOUT=180
RESEARCH_ANALYSIS_NUM_PREDICT=2048
RESEARCH_NEWS_STOCK_LIMIT_PER_SYMBOL=3
RESEARCH_NEWS_MAX_ITEMS=3
RESEARCH_NEWS_GLOBAL_LIMIT=3
