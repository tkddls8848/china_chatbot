# Copy to .env and fill the four required credentials.
TELEGRAM_BOT_TOKEN=<BotFather token>
TELEGRAM_CHAT_ID=<notification chat or channel ID>
ALLOWED_CHAT_IDS=
FEATURES_ENABLED=instruments,quant,watchlist,news,market_sentiment,research,briefing,signal_scoring,system_admin,web_admin

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TRANSLATION_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# CLOUDFLARE_ANALYSIS_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# Optional local admin page
WEB_ADMIN_HOST=127.0.0.1
WEB_ADMIN_PORT=8787
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=

# Translation and news
TRANSLATION_ENABLED=true
# 소스당 번역 건수(= Neurons를 쓰는 건수)와, 그중 실제로 보낼 건수.
# 탈락분도 news_log·prediction_log에는 남아 /view·/market이 읽는다.
NEWS_GLOBAL_LIMIT=4
NEWS_DIGEST_SEND_LIMIT=3
NEWS_GLOBAL_SOURCES=futu,sina,gnews,gnews_us,gnews_kr
NEWS_RSS_FEEDS=mk-stock|https://www.mk.co.kr/rss/50200011/
NEWS_SENTIMENT_ENABLED=true
# 실제 기사 수량을 정하는 상한. 여기서 잘린 기사는 다음 주기에도 보이지 않는다.
NEWS_SOURCE_ARTICLE_LIMIT=30
# 텀을 늘려 한 주기에 더 많은 기사를 묶어 받는다.
SCHEDULER_INTERVAL_MINUTES=20

# Research candidate source toggles
RESEARCH_SECTOR_CANDIDATES_ENABLED=true
RESEARCH_US_CANDIDATES_ENABLED=true
RESEARCH_KR_CANDIDATES_ENABLED=true

# Market sentiment source mapping
NEWS_SOURCE_MARKETS=rss:mk-stock:KR

# Polymarket 거시 위험선호 컨센서스 (30일 섀도 파일럿)
# 수집과 표시가 따로 움직인다. 파일럿 동안에는 ENABLED만 켜서 모으고,
# /system polymarket의 승격 게이트를 전부 통과할 때만 PANEL을 켠다.
# 실패로 끝나면 두 값을 모두 false로 되돌리고 관련 설정을 지운다.
POLYMARKET_ENABLED=false
POLYMARKET_PANEL_ENABLED=false
POLYMARKET_TIMEOUT=20
POLYMARKET_MIN_VOLUME=10000
POLYMARKET_MIN_LIQUIDITY=1000
POLYMARKET_MAX_SPREAD=0.05
POLYMARKET_MAX_HORIZON_DAYS=365
# 30일치 변화를 내려면 31일치 스냅숏이 필요하다(첫날은 비교 대상이 없다).
POLYMARKET_RETENTION_DAYS=31

# Scheduled briefings (host local time)
BRIEFING_MORNING_ENABLED=true
BRIEFING_MORNING_HOUR=8
BRIEFING_MORNING_MINUTE=50
BRIEFING_EVENING_ENABLED=true
BRIEFING_EVENING_HOUR=17
BRIEFING_EVENING_MINUTE=40
BRIEFING_LLM_ENABLED=true
