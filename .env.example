# 텔레그램 설정.

TELEGRAM_BOT_TOKEN=<BotFather 토큰>
TELEGRAM_CHAT_ID=<알림 채팅 또는 채널 ID>
ALLOWED_CHAT_IDS=

# Ollama 설정. -1=자동, 0=CPU, 양수=GPU 레이어 수.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_GPU=0
OLLAMA_GPU_ON_VALUE=-1

# 번역과 감성 분석.

TRANSLATION_ENABLED=true
TRANSLATION_MODEL=qwen3.5:4b
TRANSLATION_TIMEOUT=120
TRANSLATION_NUM_PREDICT=1024
TRANSLATION_PROMPT_DIR=prompts
TRANSLATION_CONCURRENCY=1

# 뉴스 수집. 전역 소스는 비우면 중국 AkShare와 Google News를 사용.

NEWS_GLOBAL_LIMIT=3
NEWS_GLOBAL_TRANSLATED_CONTENT_MAX_CHARS=180
NEWS_STOCK_TRANSLATED_CONTENT_MAX_CHARS=150
NEWS_DIGEST_MESSAGE_MAX_CHARS=3500
NEWS_STOCK_LIMIT_PER_SYMBOL=3
NEWS_GLOBAL_SOURCES=futu,em,sina,gnews,gnews_us
NEWS_RSS_FEEDS=mk-stock|https://www.mk.co.kr/rss/50200011/
NEWS_SOURCE_FAILURE_THRESHOLD=3
NEWS_SOURCE_COOLDOWN_MINUTES=60
NEWS_ENABLE_CLS=false
NEWS_SENTIMENT_ENABLED=true
NEWS_NEGATIVE_ALERT_THRESHOLD=-0.6
VIEW_LOOKBACK_DAYS=3
NEWS_SOURCE_FETCH_TIMEOUT_SECONDS=45
NEWS_SOURCE_ARTICLE_LIMIT=10
STOCK_NEWS_BATCH_SIZE=0
STOCK_NEWS_FETCH_DELAY_SECONDS=0
GLOBAL_NEWS_BATCH_SIZE=0

# 스케줄과 상태 저장.

SCHEDULER_INTERVAL_MINUTES=5
SENT_NEWS_RETENTION_DAYS=7
NEWS_LOG_RETENTION_DAYS=30
MARKET_CHART_BACKFILL_DAYS_PER_REQUEST=7

# 종목 DB와 리서치.

STOCK_DB_ENABLED=true
RESEARCH_ANALYSIS_ENABLED=true
RESEARCH_ANALYSIS_MODEL=qwen3.5:4b
RESEARCH_ANALYSIS_TIMEOUT=600
RESEARCH_ANALYSIS_NUM_PREDICT=1024
RESEARCH_ANALYSIS_NUM_CTX=16384
RESEARCH_CPU_THREADS=6
RESEARCH_MAX_CANDIDATES=10
RESEARCH_MAX_NEW_ACTIONS=4
NON_URGENT_WORKER_COUNT=3
RESEARCH_REMOVE_RELEVANCE_THRESHOLD=0.35
RESEARCH_NEWS_STOCK_LIMIT_PER_SYMBOL=3
RESEARCH_NEWS_MAX_ITEMS=3
RESEARCH_NEWS_GLOBAL_LIMIT=3
RESEARCH_VERIFICATION_ENABLED=false
RESEARCH_HISTORY_LIMIT=5
RESEARCH_SECTOR_CANDIDATES_ENABLED=true
RESEARCH_SECTOR_CANDIDATE_LIMIT=10
WENCAI_ENABLED=false
WENCAI_CANDIDATE_LIMIT=10

# 정량 보조 데이터.

QUANT_CONTEXT_ENABLED=true
QUANT_CACHE_TTL_MINUTES=10
QUANT_SECTOR_TOP_N=5
QUANT_FAILURE_COOLDOWN_MINUTES=15
# 동방재부 인기순위는 해외 IP 차단으로 기본 꺼짐. 중국 내 배포 시에만 켠다.
QUANT_HOT_RANK_ENABLED=false

# 국가·증시 감성 차트. 소스 매핑 예: rss:yonhap:KR,rss:reuters-us:US.

NEWS_SOURCE_MARKETS=rss:mk-stock:KR
MARKET_CHART_LOOKBACK_DAYS=7
MARKET_CHART_MIN_ARTICLES=6
MARKET_CHART_MIN_DAYS=3
MARKET_CHART_MARKETS=CN,HK,US,KR
NEWS_MARKET_BACKFILL_QUERIES=

# 브리핑과 주간 성적표.

BRIEFING_MORNING_ENABLED=true
BRIEFING_MORNING_HOUR=8
BRIEFING_MORNING_MINUTE=50
BRIEFING_EVENING_ENABLED=true
BRIEFING_EVENING_HOUR=17
BRIEFING_EVENING_MINUTE=40
BRIEFING_LLM_ENABLED=true
BRIEFING_NEWS_MAX_ITEMS=5
SCORECARD_ENABLED=true
SCORECARD_DAY_OF_WEEK=sat
SCORECARD_HOUR=10
SCORECARD_LOOKBACK_DAYS=30
