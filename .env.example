# ── 텔레그램 ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=           # 본인 텔레그램 ID
WEBAPP_URL=                  # ngrok URL (개발) 또는 자체 도메인 (운영)

# ── 데이터베이스 ───────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db

# ── 앱 설정 ───────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── 캐시 ──────────────────────────────────────────────
CACHE_TTL_SECONDS=900

# ── RSSHub ────────────────────────────────────────────
RSSHUB_BASE_URL=http://localhost:1200
# docker-compose 환경에서는 http://rsshub:1200

# ── RSS 피드 (쉼표 구분, URL과 레이블 순서 1:1 대응) ────
RSS_FEED_URLS=http://localhost:1200/cls/telegraph,http://localhost:1200/cls/hot,http://localhost:1200/eastmoney/report/strategyreport,http://localhost:1200/eastmoney/search/A股,http://localhost:1200/sina/news/stock,http://localhost:1200/sse/disclosure,http://localhost:1200/scmp/section/2,http://localhost:1200/reuters/cn
RSS_SOURCE_LABELS=财联社전보,财联社인기,东方财富리서치,东方财富A株,新浪财경,上交所공시,SCMP,Reuters
RSS_MAX_ITEMS_PER_FEED=20
RSS_FETCH_TIMEOUT=10

# ── 어드민 ─────────────────────────────────────────────
ADMIN_TOKEN=change-me

# ── 번역 (Ollama) ─────────────────────────────────────
TRANSLATE_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
TRANSLATE_MODEL=qwen2.5:7b
TRANSLATE_BATCH_SIZE=20
