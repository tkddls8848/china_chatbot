# Copy to .env and fill the five required credentials.
TELEGRAM_BOT_TOKEN=<BotFather token>
TELEGRAM_CHAT_ID=<notification chat or channel ID>
# 명령을 받을 chat_id(쉼표 구분). 비면 기동하지 않는다 — 빈 값을 전체 허용으로
# 읽으면 봇 사용자명을 아는 누구나 상태를 고치고 Neurons를 태울 수 있다.
ALLOWED_CHAT_IDS=<notification chat or channel ID>
FEATURES_ENABLED=instruments,quant,watchlist,news_prefilter,news,market_sentiment,research,briefing,signal_scoring,system_admin,web_admin

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 번역·분석 공용. 나눠도 단가가 같아 절감이 없다(config.py 주석 참고).
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# Optional local admin page
WEB_ADMIN_HOST=127.0.0.1
WEB_ADMIN_PORT=8787
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=

# Translation and news
TRANSLATION_ENABLED=true
# 소스당 번역 건수(= Neurons를 쓰는 건수)와, 그중 실제로 보낼 건수.
# 탈락분도 news_log·prediction_log에는 남아 /view·/market이 읽는다.
NEWS_GLOBAL_LIMIT=4
NEWS_DIGEST_SEND_LIMIT=2
NEWS_GLOBAL_SOURCES=futu,sina,gnews,gnews_us,gnews_kr
NEWS_RSS_FEEDS=mk-stock|https://www.mk.co.kr/rss/50200011/
NEWS_SENTIMENT_ENABLED=true
# 실제 기사 수량을 정하는 상한. 여기서 잘린 기사는 다음 주기에도 보이지 않는다.
# 사전선별기가 이 깊이를 로컬 CPU로 훑고 번역은 NEWS_GLOBAL_LIMIT 건만 하므로
# 값을 올려도 Neurons는 늘지 않는다. news_prefilter를 끄면 30으로 되돌린다.
NEWS_SOURCE_ARTICLE_LIMIT=250
# shadow: 점수·관측만 쌓고 번역 순서는 최신순 그대로. active: 점수 상위부터
# 번역하고 탐색 슬롯 1개로 편향 없는 라벨을 모은다. 승격 판정은
# /system prefilter와 docs/next-steps.md 1번을 따른다.
NEWS_PREFILTER_MODE=shadow

# 전일 시장 움직임과 당일 개장 전 센티먼트 일치·불일치 파일럿.
# 백필 G0·G6·G7 확인 전에는 false를 유지한다.
MARKET_ANOMALY_ENABLED=false
# G5 라이브 수집 기간에만 명시적으로 켠다(뉴스·LLM 할당량 사용).
MARKET_ANOMALY_COLLECTION_ENABLED=true
# 텀을 늘려 한 주기에 더 많은 기사를 묶어 받는다. 60분이다 — 주기가 짧으면
# 번역 슬롯이 늘 최신순 상위로 채워져 같은 사건을 하루에 몇 번씩 번역한다.
SCHEDULER_INTERVAL_MINUTES=60

# 야간(KST) 뉴스 다이제스트. 이 구간에는 기사별 번역을 하지 않고 원문만 모았다가
# 종료 시각에 시장별로 한 번씩만 요약해 보낸다. 자는 7시간을 기사별로 번역하면
# 소스 6곳 x 시간당 5건 = 210 호출이지만, 아침에 읽는 내용은 그만큼 늘지 않는다.
NEWS_NIGHT_DIGEST_ENABLED=true
NEWS_NIGHT_START_HOUR=0
NEWS_NIGHT_END_HOUR=7

# Research candidate source toggles
RESEARCH_SECTOR_CANDIDATES_ENABLED=true
RESEARCH_US_CANDIDATES_ENABLED=true
RESEARCH_KR_CANDIDATES_ENABLED=true

# Market sentiment source mapping
NEWS_SOURCE_MARKETS=rss:mk-stock:KR

# Polymarket 거시 위험선호 컨센서스 (섀도 파일럿)
# 수집과 표시가 따로 움직인다. 파일럿 동안에는 ENABLED만 켜서 모으고,
# 승격 게이트를 전부 통과할 때만 PANEL을 켠다. 게이트의 실질은 과거 시세
# 백필(app/polymarket_backfill.py)이 판정하고, 라이브에서는 스냅숏 job의
# 가동률만 확인한다.
# 실패로 끝나면 두 값을 모두 false로 되돌리고 관련 설정을 지운다.
# 선택 게이트 임계값은 파일럿 도중 바꾸지 않는 값이라 config.py의 상수다.
POLYMARKET_ENABLED=true
POLYMARKET_PANEL_ENABLED=false

# Scheduled briefings (host local time)
BRIEFING_MORNING_ENABLED=true
BRIEFING_MORNING_HOUR=8
BRIEFING_MORNING_MINUTE=50
BRIEFING_EVENING_ENABLED=true
BRIEFING_EVENING_HOUR=17
BRIEFING_EVENING_MINUTE=40
BRIEFING_LLM_ENABLED=true
