[Unit]
Description=Stock Chatbot public read-only web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/stock_chatbot/app
Environment=PYTHONUNBUFFERED=1
Environment=MPLBACKEND=Agg
Environment=WEBPUB_HOST=127.0.0.1
Environment=WEBPUB_PORT=8788
ExecStart=/home/ubuntu/stock_chatbot/venv/bin/python webpub.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
