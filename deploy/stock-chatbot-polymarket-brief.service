[Unit]
Description=Build Polymarket sector consensus paragraphs
After=stock-chatbot-polymarket-refresh.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/stock_chatbot/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/stock_chatbot/venv/bin/python polymarket_sector_brief.py
Nice=10
CPUWeight=20
MemoryMax=256M
TimeoutStartSec=10min
